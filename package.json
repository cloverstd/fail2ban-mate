{
  "name": "fail2ban-mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build && vite build --mode admin",
    "build:cloudflare": "node scripts/configure-deploy.mjs && pnpm build && pnpm test && node --test tests/deploy-config.test.mjs tests/public-build.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:cloudflare": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.json && wrangler deploy --config wrangler.deploy.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "hono": "^4.13.16",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.2.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
